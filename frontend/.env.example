# PARVARISH University Web Application — Environment Configuration
# Copy this file to .env and provide your production Supabase keys

# Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Client Key (public anon key)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend API Base (optional for custom deployment; defaults to proxy /api)
# VITE_API_URL=http://localhost:5000/api
